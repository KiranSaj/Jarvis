{
  "permissions": {
    "allow": [
      "Bash(docker compose logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up -d:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker ps:*)",
      "Bash(ollama list:*)",
      "Bash(ollama ps:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(node --check:*)",
      "Bash(node check.mjs:*)",
      "Bash(node .claude/session-budget.js:*)",
      "Bash(awk:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "PowerShell(node check.mjs:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(ollama list:*)",
      "PowerShell(ollama ps:*)",
      "PowerShell(Get-NetFirewallRule:*)",
      "PowerShell(Get-NetIPAddress:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/check.mjs\" --hook",
            "timeout": 30,
            "statusMessage": "Checking the joke bank and validator"
          }
        ]
      }
    ]
  }
}
